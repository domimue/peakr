{
  "name": "peakr",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "pnpm -r --no-bail lint",
    "typecheck": "pnpm -r --no-bail typecheck",
    "test": "pnpm -r --no-bail test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mobile": "pnpm --filter @peakr/mobile start",
    "web": "pnpm --filter @peakr/web dev"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "supabase": "^2.121.0",
    "typescript": "~6.0.3"
  }
}
