{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@peakr/web", "dev"],
      "port": 3000
    },
    {
      "name": "mobile",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@peakr/mobile", "start"],
      "port": 8081
    },
    {
      "name": "mobile-offline",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@peakr/mobile", "start", "--offline", "--clear"],
      "port": 8081
    }
  ]
}
