# Public URL of the site, used for canonical links, sitemap, Open Graph, Stripe return URLs and
# sign-in redirects (no trailing slash). On Vercel this falls back to the production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Project Settings → API keys).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret (service role) key – server only. Attaches a checkout to the account and writes the plan.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Signs the cookie that remembers this browser's quiz (openssl rand -base64 32).
FUNNEL_COOKIE_SECRET=

# Stripe (test mode while developing), see docs/web-checkout-setup.md.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_TRAINING_MONTHLY=price_xxx
STRIPE_PRICE_TRAINING_YEARLY=price_xxx
# Training + Nutrition – later.
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=

# RevenueCat: public key of the Stripe app (strp_…) and the v1 secret key (server only).
REVENUECAT_STRIPE_PUBLIC_KEY=strp_xxx
REVENUECAT_SECRET_KEY=sk_xxx

# Store pages for "Get the app" – only once the app is published there.
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APP_STORE_URL=
