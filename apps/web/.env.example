# Public URL of the site, used for canonical links, sitemap and Open Graph (no trailing slash).
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Project Settings → API keys). Only the publishable/anon key – never the secret key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
