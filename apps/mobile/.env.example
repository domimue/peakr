# Copy to .env.local (not committed). Supabase project → Project Settings → API keys.
# Only the publishable key belongs in the app – never the secret / service-role key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Google sign-in uses the Supabase OAuth flow in the browser; no client id is needed in the app.

# Route maps (MapTiler Outdoor). Client tile key, restrict it in the MapTiler dashboard.
EXPO_PUBLIC_MAPTILER_KEY=
