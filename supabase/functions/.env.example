# Secrets of the Edge Functions. Local: copy to supabase/functions/.env (not committed).
# Hosted: Supabase dashboard → Edge Functions → Secrets, or `pnpm exec supabase secrets set --env-file …`.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase automatically.

# 32 random bytes, base64url: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TOKEN_ENCRYPTION_KEY=
# Any long random string (same command as above).
OAUTH_STATE_SECRET=
# Health values (Phase 9d), its own 32 random bytes, base64url (same command as above).
HEALTH_ENCRYPTION_KEY=
# Garmin health data: Health API push over OAuth once Garmin approved Peakr (Starter tier).
GARMIN_HEALTH=
# Developer only: allow pasting a Garmin Personal API key (docs/health-garmin.md).
GARMIN_PERSONAL_KEY=

# https://www.strava.com/settings/api – Authorization Callback Domain: <project-ref>.supabase.co
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Strava webhook (see supabase/README.md "Strava webhook subscription"): any long random string,
# the same value you pass as verify_token when creating the subscription.
STRAVA_WEBHOOK_VERIFY_TOKEN=
# The id Strava returns when the subscription is created (events with another id are ignored).
STRAVA_SUBSCRIPTION_ID=

# Nightly catch-up: the same value as the Vault secret `cron_secret`.
CRON_SECRET=

# Optional: Expo access token, needed once "Enhanced security for push notifications" is on.
EXPO_ACCESS_TOKEN=

# Weather check (functions/weather). Empty = the free Open-Meteo API, which is for NON-COMMERCIAL
# use only (development). Before launch: an Open-Meteo API plan key (customer-api.open-meteo.com).
OPEN_METEO_API_KEY=

# Subscriptions (Phase 10, docs/subscriptions-setup.md).
# RevenueCat → Project settings → API keys → secret key (v1). Used to read a subscriber after each
# webhook event and to delete the customer on account deletion.
REVENUECAT_SECRET_KEY=
# RevenueCat → Integrations → Webhooks → Authorization header value, exactly (e.g. "Bearer <random>").
REVENUECAT_WEBHOOK_AUTH=
# Website base URL (cancel link for web subscribers in the trial reminder), e.g. https://peakr.ch
SITE_URL=
# Trial-ending email. Without both, the reminder goes out as push only.
RESEND_API_KEY=
EMAIL_FROM=

# Website checkout (Phase 10b, docs/web-checkout-setup.md). Stripe secret key – account deletion
# cancels the user's website subscriptions with it. SITE_URL above also builds the link in the
# "create your account" reminder (checkout-reminders).
STRIPE_SECRET_KEY=
